# ── 백엔드(Render 등) ──────────────────────────────────────────
# Render / Railway 등 배포 서버에 환경변수로 주입
OPENAI_API_KEY=sk-...

# CORS 허용 오리진 (쉼표 구분, Vercel 주소 포함)
CORS_ORIGINS=https://your-app.vercel.app

# ── Vercel(프론트) ────────────────────────────────────────────
# 백엔드 URL — /api/* 요청이 여기로 프록시됩니다
API_URL=https://your-backend.onrender.com

# ── 로컬 개발 ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
